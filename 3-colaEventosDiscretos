# Función para obtener los valores matemáticos exactos y compararlos
def calcular_teoricos(lambd, mu, limite_cola):
    rho = lambd / mu
    
    # Modelo M/M/1 (Cola Infinita)
    if limite_cola == float('inf'):
        if rho >= 1:
            return {"Lq": "No se puede calcular", "L": "No se puede calcular", 
                    "Wq": "No se puede calcular", "W": "No se puede calcular", 
                    "Util": "No se puede calcular", "P_deneg": "No se puede calcular"}
        else:
            L = rho / (1 - rho)
            Lq = (rho**2) / (1 - rho)
            W = 1 / (mu - lambd)
            Wq = rho / (mu - lambd)
            return {"Lq": f"{Lq:.2f}", "L": f"{L:.2f}", "Wq": f"{Wq:.4f}", 
                    "W": f"{W:.4f}", "Util": f"{rho:.2%}", "P_deneg": "0.00%"}
    
    # Modelo M/M/1/K (Cola Finita, donde K = límite de cola + 1 en servicio)
    else:
        K = limite_cola + 1
        if rho == 1:
            P0 = 1 / (K + 1)
            Pk = 1 / (K + 1)
            L = K / 2
        else:
            P0 = (1 - rho) / (1 - rho**(K+1))
            Pk = (rho**K) * P0
            L = (rho / (1 - rho)) - ((K + 1) * rho**(K+1) / (1 - rho**(K+1)))
        
        lambda_eff = lambd * (1 - Pk)
        if lambda_eff > 0:
            W = L / lambda_eff
            Wq = W - (1 / mu)
            Lq = lambda_eff * Wq
        else:
            W, Wq, Lq = 0, 0, 0
            
        utilizacion = 1 - P0
        return {"Lq": f"{max(0, Lq):.2f}", "L": f"{L:.2f}", "Wq": f"{max(0, Wq):.4f}", 
                "W": f"{W:.4f}", "Util": f"{utilizacion:.2%}", "P_deneg": f"{Pk:.2%}"}

def graficar_resultados(datos_hist_n, lista_tiempos_sistema, lista_tiempos_cola, capacidad):
    # Gráfico 1: Barras horizontales (Probabilidad Discreta)
    plt.figure(figsize=(6, 5))
    # Para colas infinitas, limitamos el gráfico a 15 para que sea legible
    clientes = [k for k in datos_hist_n.keys() if k <= 15] 
    probabilidades = [datos_hist_n[k] for k in clientes]
    
    acumulada_n = []
    suma_temp = 0
    for p in probabilidades:
        suma_temp += p
        acumulada_n.append(suma_temp)
        
    plt.barh(clientes, probabilidades, label='Discreta', height=0.4)
    plt.plot(acumulada_n, clientes, marker='o', label='Acumulada', linewidth=2)
    plt.gca().invert_yaxis()
    
    titulo_cap = "Infinita" if math.isinf(capacidad) else capacidad
    plt.title(f'Probabilidades (Capacidad: {titulo_cap} | Carga: 75%)', fontsize=12)
    plt.xlabel('Probabilidad')
    plt.ylabel('Clientes en Cola')
    plt.xlim(-0.05, 1.25)
    plt.yticks(clientes)
    plt.legend(loc='upper right', frameon=False)
    plt.tight_layout()
    plt.show()

    # Gráfico 2: Probabilidad basada en el tiempo
    if lista_tiempos_sistema and lista_tiempos_cola:
        plt.figure(figsize=(6, 5))
        ts_ordenados = sorted(lista_tiempos_sistema)
        tq_ordenados = sorted(lista_tiempos_cola)
        
        pasos_grafico = max(10, min(50, len(ts_ordenados) // 10))
        indices_ts = [int(i * (len(ts_ordenados) - 1) / (pasos_grafico - 1)) for i in range(pasos_grafico)]
        indices_tq = [int(i * (len(tq_ordenados) - 1) / (pasos_grafico - 1)) for i in range(pasos_grafico)]
        
        puntos_x_ts = [ts_ordenados[idx] for idx in indices_ts]
        puntos_y_ts = [indices_ts[i] / len(ts_ordenados) for i in range(pasos_grafico)]
        puntos_x_tq = [tq_ordenados[idx] for idx in indices_tq]
        puntos_y_tq = [indices_tq[i] / len(tq_ordenados) for i in range(pasos_grafico)]
        
        plt.plot(puntos_x_ts, puntos_y_ts, marker='o', label='Tiempo en sistema', linewidth=2)
        plt.plot(puntos_x_tq, puntos_y_tq, marker='d', label='Tiempo en cola', linewidth=1.5)
        
        plt.title(f'Tiempos (Capacidad: {titulo_cap} | Carga: 75%)', fontsize=12)
        plt.xlabel('Tiempo Transcurrido')
        plt.ylabel('Probabilidad Acumulada')
        plt.ylim(-0.05, 1.25)
        plt.legend(loc='lower right', frameon=False)
        plt.tight_layout()
        plt.show()

# SIMULACION M/M/1 - EVENTOS DISCRETOS
def simular(lambda_arribo, limite_cola):
    en_sistema = 0
    tiempo_actual = 0.0
    
    # Eventos futuros
    t_proxima_llegada = random.expovariate(lambda_arribo)
    t_proxima_salida = float('inf') # Infinito significa que el servidor está inactivo
    
    # Contadores
    intentos_arribo = 0
    rechazados = 0
    cola_llegadas = [] 
    tiempos_cola = []
    tiempos_sistema = []
    
    # Acumuladores de área (Tiempo * Cantidad)
    area_en_cola = 0.0
    area_en_sistema = 0.0
    tiempo_ocupado = 0.0
    tiempo_en_n_clientes = {} 

    while tiempo_actual < tiempo_total:
        # Avanzar el reloj al próximo evento
        t_evento = min(t_proxima_llegada, t_proxima_salida)
        
        if t_evento > tiempo_total:
            delta_t = tiempo_total - tiempo_actual
            tiempo_actual = tiempo_total
        else:
            delta_t = t_evento - tiempo_actual
            tiempo_actual = t_evento
        
        # Calcular estados para acumular áreas de las estadísticas continuas
        en_cola_actual = max(0, en_sistema - 1)
        area_en_sistema += en_sistema * delta_t
        area_en_cola += en_cola_actual * delta_t
        if en_sistema > 0:
            tiempo_ocupado += delta_t
            
        tiempo_en_n_clientes[en_cola_actual] = tiempo_en_n_clientes.get(en_cola_actual, 0) + delta_t

        if tiempo_actual >= tiempo_total:
            break

        # EVENTO: LLEGADA
        if t_evento == t_proxima_llegada:
            intentos_arribo += 1
            t_proxima_llegada = tiempo_actual + random.expovariate(lambda_arribo)
            
            if en_cola_actual >= limite_cola:
                rechazados += 1 
            else:
                en_sistema += 1
                if en_sistema == 1: 
                    # Pasa directo al servidor vacío
                    ts = random.expovariate(mu)
                    tiempos_cola.append(0)
                    tiempos_sistema.append(ts)
                    t_proxima_salida = tiempo_actual + ts
                else:
                    # Espera en cola
                    cola_llegadas.append(tiempo_actual)

        # EVENTO: SALIDA
        else:
            en_sistema -= 1
            if en_sistema > 0:
                # Entra a servicio el próximo en la cola
                t_llegada_cliente = cola_llegadas.pop(0)
                tiempo_esperado = tiempo_actual - t_llegada_cliente
                ts = random.expovariate(mu)
                
                tiempos_cola.append(tiempo_esperado)
                tiempos_sistema.append(tiempo_esperado + ts)
                t_proxima_salida = tiempo_actual + ts
            else:
                # El servidor queda libre
                t_proxima_salida = float('inf')

    # Calcular estadísticas finales dividiendo áreas sobre tiempo total
    probabilidades_n = {n: t / tiempo_total for n, t in tiempo_en_n_clientes.items()}
    prob_denegacion = rechazados / intentos_arribo if intentos_arribo > 0 else 0

    return {
        'en_cola_promedio': area_en_cola / tiempo_total,
        'en_sistema_promedio': area_en_sistema / tiempo_total,
        'utilizacion': tiempo_ocupado / tiempo_total,
        'prob_denegacion': prob_denegacion,
        'tiempos_cola': tiempos_cola,
        'tiempos_sistema': tiempos_sistema,
        'probabilidades_n': probabilidades_n
    }


