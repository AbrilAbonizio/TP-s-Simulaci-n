			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[try {
    java.io.File f = new java.io.File("resultados_" + (root.habilitarRotura ? "rotura" : "base") + ".csv");
    boolean nuevo = !f.exists();
    java.io.FileWriter fw = new java.io.FileWriter(f, true);
    if (nuevo) fw.write("rotura;maquinaRota;wqGuardado;tBotado;tTotalGuardado;ascRetenido;utilAsc1;utilAsc2;utilGrua1;utilGrua2;picoCola;horaPico;nBotados;nGuardados\n");
    fw.write(root.resultadosCSV() + "\n");
    fw.close();
    traceln("CSV: " + f.getAbsolutePath());
} catch (Exception e) {
    e.printStackTrace();
}]]></AfterSimulationRunCode>
