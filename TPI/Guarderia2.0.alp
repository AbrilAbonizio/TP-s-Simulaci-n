		<ActiveObjectClass>
			<Id>1790026647919</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[int columnas = 15;   // bahías a lo largo del rack
int estantes = 7;    // niveles verticales
int lados = 2;       // dos unidades back-to-back
int espaciosPorGalpon = columnas * estantes * lados;   // 210

// Origen de cada galpón: AJUSTAR mirando la animación
double origenX = 1100;
double origenYG1 = 450;
double origenYG2 = 710;
double origenZ = 0;

// 10 píxeles = 1 metro
double separacionX = 66.67;
double separacionY = 70;
double separacionZ = 30;

if (espacios.size() != espaciosPorGalpon * 2) {
    traceln("Error: hay " + espacios.size() + " espacios y se esperaban " + (espaciosPorGalpon * 2));
}

int espaciosPorLado = columnas * estantes;   // 105

for (int i = 0; i < espacios.size(); i++) {
    Espacio e = espacios(i);

    int galpon = (i < espaciosPorGalpon) ? 1 : 2;
    int local = i % espaciosPorGalpon;

    int lado = local / espaciosPorLado;         // 0 o 1
    int resto = local % espaciosPorLado;
    int estante = resto / columnas;             // 0 a 6
    int columna = resto % columnas;             // 0 a 14

    e.idEspacio = "G" + galpon + "-E" + String.format("%03d", local + 1);
    e.galpon = galpon;
    e.nivel = lado;
    e.fila = estante;
    e.columna = columna;

    double origenY = (galpon == 1) ? origenYG1 : origenYG2;
    e.destinoX = origenX + columna * separacionX;
    e.destinoY = origenY + lado * separacionY;
    e.destinoZ = origenZ + estante * separacionZ;

    e.ocupado = false;
    e.idEmbarcacionReservada = "";
    
     if (local >= 204) {            // los últimos 6 de cada galpón no existen
        e.ocupado = true;
        e.idEmbarcacionReservada = "FUERA_DE_SERVICIO";
    }
}
	int nLanchas = (int) Math.round(nBotados * 0.62);
	precargaLanchas.inject(nLanchas);
	precargaMotos.inject(nBotados - nLanchas);
	]]></StartupCode>
