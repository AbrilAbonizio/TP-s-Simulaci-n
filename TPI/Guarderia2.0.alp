			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Espacio]]></ReturnType>
					<Id>1791850471150</Id>
					<Name><![CDATA[buscarEspacio]]></Name>
					<X>420</X><Y>940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < espacios.size(); i++) {
    Espacio e = espacios(i);

    if (e.idEspacio.equals(id)) {
        return e;
    }
}

return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Espacio]]></ReturnType>
					<Id>1791851246702</Id>
					<Name><![CDATA[reservarEspacio]]></Name>
					<X>420</X><Y>980</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Embarcacion]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[galpon]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < espacios.size(); i++) {
    Espacio e = espacios(i);
    if (e.galpon == galpon && !e.ocupado) {
        e.ocupado = true;
        e.idEmbarcacionReservada = b.idEmbarcacion;
        b.espacioAsignado = e;
        b.idEspacioAsignado = e.idEspacio;
        return e;
    }
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791851314519</Id>
					<Name><![CDATA[liberarEspacio]]></Name>
					<X>420</X><Y>1010</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Embarcacion]]></Type>
					</Parameter>
					<Body><![CDATA[if (b.espacioAsignado != null) {
    b.espacioAsignado.ocupado = false;
    b.espacioAsignado.idEmbarcacionReservada = "";
    b.espacioAsignado = null;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791851364369</Id>
					<Name><![CDATA[elegirGalpon]]></Name>
					<X>420</X><Y>1040</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int libres1 = 0, libres2 = 0;
for (int i = 0; i < espacios.size(); i++) {
    Espacio e = espacios(i);
    if (!e.ocupado) { if (e.galpon == 1) libres1++; else libres2++; }
}
if (libres1 == 0 && libres2 == 0) return 0;   // no hay lugar
if (libres1 == 0) return 2;
if (libres2 == 0) return 1;
// Ambos tienen lugar: elegir el de menor cola en el río
if (enColaAsc1 == enColaAsc2) return randomTrue(0.5) ? 1 : 2;
return (enColaAsc1 < enColaAsc2) ? 1 : 2;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794952250378</Id>
					<Name><![CDATA[perfilManana]]></Name>
					<X>420</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[h]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (h < 10) return 1.0;
if (h < 12) return 0.6;
if (h < 16) return 0.15;
return 0.05;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794952325906</Id>
					<Name><![CDATA[sortearHoraSolicitud]]></Name>
					<X>420</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double h;
do {
    h = uniform(8, 20);
} while (uniform() > perfilManana(h));
return (h - 8) * 60;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795269202428</Id>
					<Name><![CDATA[combinar]]></Name>
					<X>420</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[na]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ma]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nb]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mb]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (na + nb == 0) return 0;
double sa = (na > 0) ? na * ma : 0;
double sb = (nb > 0) ? nb * mb : 0;
return (sa + sb) / (na + nb);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1795269339419</Id>
					<Name><![CDATA[resultadosCSV]]></Name>
					<X>420</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double wq  = combinar(finEspera1.distribution.count(), finEspera1.distribution.mean(), finEspera2.distribution.count(), finEspera2.distribution.mean());
double bot = combinar(finBot1.distribution.count(),    finBot1.distribution.mean(),    finBot2.distribution.count(),    finBot2.distribution.mean());
double tot = combinar(finTotal1.distribution.count(),  finTotal1.distribution.mean(),  finTotal2.distribution.count(),  finTotal2.distribution.mean());
double ret = combinar(finAsc1.distribution.count(),    finAsc1.distribution.mean(),    finAsc2.distribution.count(),    finAsc2.distribution.mean());
int maq = habilitarRotura ? maquinaRota : -1;
return String.format(java.util.Locale.forLanguageTag("es-AR"),
    "%d;%d;%.3f;%.3f;%.3f;%.3f;%.4f;%.4f;%.4f;%.4f;%d;%.2f;%d;%d",
    habilitarRotura ? 1 : 0, maq, wq, bot, tot, ret,
    ascensor1.utilization(), ascensor2.utilization(), grua1.utilization(), grua2.utilization(),
    picoCola, 8 + horaPico / 60.0,
    finBot1.distribution.count() + finBot2.distribution.count(), finTotal1.distribution.count() + finTotal2.distribution.count());]]></Body>
				</Function>
			</Functions>

