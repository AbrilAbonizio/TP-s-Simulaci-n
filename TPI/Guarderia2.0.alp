							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!habilitarRotura) return;
switch (maquinaRota) {
    case 0: grua1.set_capacity(0); break;
    case 1: grua2.set_capacity(0); break;
    case 2: ascensor1.set_capacity(0); break;
    case 3: ascensor2.set_capacity(0); break;
}]]></Action>
				</Event>
